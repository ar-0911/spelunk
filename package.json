{
  "name": "spelunk-cli",
  "version": "0.1.0",
  "description": "Understand any codebase: where code lives, how it's written, and how the pieces connect. CLI and MCP server.",
  "type": "module",
  "bin": {
    "spelunk": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ar-0911/spelunk.git"
  },
  "keywords": [
    "codebase",
    "code-understanding",
    "tree-sitter",
    "mcp",
    "claude",
    "static-analysis"
  ]
}
